[Unit]
Description=ILRC Combined Production Shadow
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/RustNautilasProject
ExecStart=/home/ubuntu/RustNautilasProject/deploy/run-ilrc-production-shadow.sh 86360
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/RustNautilasProject/data
Environment=RUST_BACKTRACE=1

[Install]
WantedBy=multi-user.target
