[Unit]
Description=CRUDEOIL Supertrend MACD VWAP session (paper orders)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/RustNautilasProject
ExecStart=/home/ubuntu/RustNautilasProject/target/release/kite-node native-supertrend-session-paper config/production-supertrend.json
Restart=no
KillSignal=SIGTERM
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kite-supertrend-paper

[Install]
WantedBy=multi-user.target
